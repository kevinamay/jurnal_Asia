# Konfigurasi Gateway Pengiriman OTP Otomatis Portal Asia Plastik

# 1. WhatsApp Gateway (Fonnte - Sangat direkomendasikan untuk Indonesia)
# Daftar gratis di https://fonnte.com, sambungkan WhatsApp perangkat Anda, lalu tempelkan Token di bawah:
FONNTE_TOKEN=

# 2. Alternatif WhatsApp Gateway (Wablas)
# WABLAS_TOKEN=
# WABLAS_DOMAIN=https://...

# 3. Email Gateway (Resend)
# Daftar gratis di https://resend.com, dapatkan API Key lalu tempelkan di bawah:
# RESEND_API_KEY=re_...
